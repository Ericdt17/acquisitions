# Copier vers `.env.development` : `cp .env.development.example .env.development`
#
# Avec `docker compose -f docker-compose.dev.yml up`, DATABASE_URL est injectée
# par docker-compose (voir docker-compose.dev.yml). Les variables ci-dessous
# complètent la config (JWT, logs, etc.).

NODE_ENV=development
PORT=3001

# Optionnel si tu lances l’app hors Docker mais Postgres dans Docker sur le host :
# DATABASE_URL=postgresql://acquisitions:acquisitions_dev@localhost:5432/acquisitions

JWT_SECRET=change-me-in-development
JWT_EXPIRES_IN=1d
LOG_LEVEL=info
