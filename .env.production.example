# Copier vers `.env.production` sur le serveur (ne jamais committer les secrets réels).
#
# OBLIGATOIRE : URL Postgres de production (TLS souvent requis).
# Exemple : postgresql://user:password@db.example.com:5432/acquisitions?sslmode=require

NODE_ENV=production
PORT=3001

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

JWT_SECRET=generate-a-long-random-secret
JWT_EXPIRES_IN=1d
LOG_LEVEL=info
